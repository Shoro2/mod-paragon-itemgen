[worldserver]

###############################################################################
# PARAGON ITEM SCALING MODULE
#
# Applies bonus enchantments to weapons/armor based on player Paragon level.
#
# Item Enchantment Slots:
#   Slot 0: Stamina (always applied)
#   Slot 1: Main stat (player choice: Str/Agi/Int/Spi)
#   Slot 2: Random combat rating (from role-based pool)
#   Slot 3: Random combat rating (from role-based pool, no duplicate)
#   Slot 4: Talent spell (TODO: placeholder for custom spells)
#
# Roles: Tank, DPS, Healer
#   Tank pool:   Dodge, Parry, Defense, Block, Hit, Expertise
#   DPS pool:    Crit, Haste, Hit, ArmorPen, Expertise, AP, SP
#   Healer pool: Crit, Haste, Spell Power, MP5
#
# Player commands:
#   .paragon role tank|dps|healer  (rested area only)
#   .paragon stat str|agi|int|spi  (rested area only)
#   .paragon info
#
# Items keep their stats permanently. Changing role/stat only affects NEW items.
# Trade/Mail to lower-paragon players is blocked.
###############################################################################

# Enable/disable the module
ParagonItemGen.Enable = 1

# Item sources that receive paragon enchantments
ParagonItemGen.OnLoot   = 1
ParagonItemGen.OnCreate = 1
ParagonItemGen.OnQuest  = 1
ParagonItemGen.OnVendor = 1

# Scaling formula: statAmount = ceil(paragonLevel * ScalingFactor * QualityMult)
# Tuned so that cursed legendary at max paragon level (666) hits exactly +666 stats.
# Example at Paragon Level 20:
#   Uncommon: +6 per stat | Rare: +8 | Epic: +11 | Legendary: +14
# At Paragon Level 666:
#   Legendary: +444 (normal) | +666 (cursed)
ParagonItemGen.ScalingFactor = 0.533333

# Quality multipliers
ParagonItemGen.QualityMult.Uncommon  = 0.5
ParagonItemGen.QualityMult.Rare      = 0.75
ParagonItemGen.QualityMult.Epic      = 1.0
ParagonItemGen.QualityMult.Legendary = 1.25

# Minimum paragon level required for enchantments
ParagonItemGen.MinParagonLevel = 1

# Minimum item level required
ParagonItemGen.MinItemLevel = 150

# Transfer restrictions
ParagonItemGen.BlockTrade = 1
ParagonItemGen.BlockMail  = 1

# Cursed items: small chance for an item to roll "cursed"
# Cursed items get all stats at CursedMultiplier * max value and become soulbound.
# A shadow visual plays on the player when this happens.
#
# Switch: 0 = no cursed items at all, any other value = on. (Until 2026-10-29 this was the chance itself.)
ParagonItemGen.CursedChance = 50.0
#
# The chance in percent rises evenly with the account's Paragon level: Level0 at Paragon 0, Cap at CapLevel,
# Cap above it (the operator 2026-10-29: 0.5 % at level 0 to 2 % at Paragon 200, "ultra selten").
ParagonItemGen.CursedChance.Level0 = 0.5
ParagonItemGen.CursedChance.Cap = 2.0
ParagonItemGen.CursedChance.CapLevel = 200
#
# Stat multiplier for cursed items (1.5 = 150% of max stat value)
ParagonItemGen.CursedMultiplier = 1.5
#
# SpellVisualKit ID for the shadow animation on cursed roll
# Default 5765 is a shadow/dark visual effect. Change to any SpellVisualKit.dbc entry.
ParagonItemGen.CursedVisualKit = 5765
#
# Forgotten Talents bonus on the cursed chance (1 = on, 0 = off)
# Two talent nodes raise the chance, each only for the item source it owns:
# "Tainted Craft" (tag 76002) on crafted items, "Dark Bargain" (tag 76003) on
# quest rewards. Looted and bought items never get a bonus.
# The talent value is added as percent POINTS on top of CursedChance
# times CursedTalentScale (since 2026-10-29 0.04: the base went from 50 % to 2 %, the talents shrink alike -
# a rank worth 10 adds 0.4 points), and the sum is capped at 100.
# The module matches the tag in EffectMiscValue, never a spell id, so the
# talents keep working when their spell records are re-generated.
# CursedChance = 0 still disables cursed items entirely: the bonus can only
# raise a chance that is already allowed, it never re-enables a disabled roll.
ParagonItemGen.CursedTalentBonus = 1
ParagonItemGen.CursedTalentScale = 0.04

###############################################################################
# PASSIVE SPELL EFFECTS
#
# Each non-cursed item can roll a passive spell effect on Slot 4 (slot 11).
# Effects are defined in the paragon_passive_spell_pool table (world DB)
# and include stat % buffs, combat rating boosts, and proc effects.
# Effects are filtered by player role and paragon/item level requirements.
#
# The pool is loaded on server startup and reloaded on config reload.
# Add/remove/modify effects by editing paragon_passive_spell_pool rows.
###############################################################################

# Enable/disable passive spell effects on items
ParagonItemGen.PassiveSpell.Enable = 1

# Chance (percent) for an item to receive a passive spell effect
# 100.0 = every item gets one, 50.0 = 50% chance, 0 = disabled
ParagonItemGen.PassiveSpell.Chance = 100.0

###############################################################################
# CURSED ALTAR
#
# The altar object (gameobject 921010, ScriptName go_paragon_cursed_altar, in the
# Hall of the Guardian on map 736) turns cursed items into an account-wide
# collection of passives and back:
#   Sacrifice: a cursed item is destroyed, its passive (slot 11, 950001-950999)
#              joins the account's collection (account_paragon_passive_collection)
#              and the player gets Cursed Essence (item 920300) by item quality.
#              A cursed item with only the plain "Cursed" marker pays but unlocks
#              nothing.
#   Bind:      an eligible item from the bags is re-rolled as a cursed item at the
#              player's current Paragon level with exactly one collected passive
#              of the player's class in slot 11. It costs Cursed Essence and
#              Tainted Heartstones (item 920301), by the quality of the TARGET item.
#              The cursed-item kill switch (CursedChance = 0) also stops binds.
#
# Chat commands behind the window (SEC_PLAYER):
#   .paragon altar sync | sacrifice <bag> <slot> | bind <bag> <slot> <enchantmentId>
# Sacrifice and bind only work within Altar.Range of a spawned altar object.
###############################################################################

# Enable/disable the altar (0: the object does nothing, the commands refuse)
ParagonItemGen.Altar.Enable = 1

# How close (yards) a player must be to a spawned altar object to sacrifice or bind
ParagonItemGen.Altar.Range = 10

# Cursed Essence paid per sacrificed item, by the item's quality
ParagonItemGen.Altar.Yield.Uncommon  = 1
ParagonItemGen.Altar.Yield.Rare      = 5
ParagonItemGen.Altar.Yield.Epic      = 10
ParagonItemGen.Altar.Yield.Legendary = 1000

# Cursed Essence a bind costs, by the quality of the TARGET item
ParagonItemGen.Altar.Cost.Uncommon  = 10
ParagonItemGen.Altar.Cost.Rare      = 30
ParagonItemGen.Altar.Cost.Epic      = 100
ParagonItemGen.Altar.Cost.Legendary = 300

# Tainted Heartstones a bind costs on top, by the quality of the TARGET item
# (how heartstones are obtained is not part of this module's altar)
ParagonItemGen.Altar.MaterialCost.Uncommon  = 1
ParagonItemGen.Altar.MaterialCost.Rare      = 2
ParagonItemGen.Altar.MaterialCost.Epic      = 5
ParagonItemGen.Altar.MaterialCost.Legendary = 10
